{
  "name": "mcslice-rush",
  "version": "0.1.0",
  "private": true,
  "description": "Slice Rush — McDonald's campaign build (McSlice Rush). One reusable HTML5 slicing engine, reskinned per restaurant by configuration.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "python server.py",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "validate:campaigns": "node scripts/validate-campaigns.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run validate:campaigns && npm run test",
    "build": "node scripts/build.mjs && node scripts/build-dashboard.mjs",
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "perf": "node scripts/perf-baseline.mjs",
    "preview": "python -c \"import os,http.server,socketserver;os.chdir('dist');socketserver.TCPServer.allow_reuse_address=True;socketserver.TCPServer(('',8767),http.server.SimpleHTTPRequestHandler).serve_forever()\""
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.1"
  }
}
