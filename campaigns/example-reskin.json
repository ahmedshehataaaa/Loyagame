{
  "_comment": "A second campaign that exists to PROVE the reskin path: nothing about it shares code with mcdonalds.json, only the manifest shape. Sprites intentionally reuse the McDonald's assets in this repo — the point is the config boundary, not new art. Validated in CI by scripts/validate-campaigns.mjs and exercised by tests/e2e/campaign.spec.js.",

  "schemaVersion": 1,

  "brand": {
    "id": "demo-diner",
    "name": "Demo Diner",
    "gameName": "Diner Dash Slice",
    "tagline": "Slice Fast, Eat Free",
    "slogan": "always fresh",
    "logo": "assets/brand-logo.png",
    "knife": "🔪",
    "colors": {
      "primary": "#00653A",
      "primary2": "#004A2A",
      "accent": "#F0B323",
      "accent2": "#B8860B",
      "ink": "#12211A",
      "surface": "#FFF6E8"
    },
    "locales": ["en"],
    "features": { "wheel": false, "leaderboard": true, "soundDefault": false }
  },

  "rules": { "roundSeconds": 45, "lives": 3 },

  "items": [
    {
      "id": "burger",
      "label": "House Burger",
      "img": "assets/items/bigmac.png",
