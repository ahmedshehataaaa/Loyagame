      "radius": 54,
      "juice": "#c98b3a",
      "hero": true
    },
    {
      "id": "shake",
      "label": "Thick Shake",
      "img": "assets/items/mcflurry.png",
      "points": 350,
      "radius": 48,
      "juice": "#efe6d6"
    },
    {
      "id": "chips",
      "label": "Skin-On Chips",
      "img": "assets/items/fries.png",
      "points": 200,
      "radius": 50,
      "juice": "#e8b23c"
    }
  ],

  "hazard": {
    "id": "scorched",
    "label": "Scorched batch — avoid!",
    "img": "assets/items/burnt.png",
    "radius": 48,
    "juice": "#20140c"
  },

  "rewards": {
    "pointsThreshold": 1500,
    "prizes": [
      { "key": "chips", "label": "Free Chips", "weight": 60 },
      { "key": "shake", "label": "Free Thick Shake", "weight": 30 },
      { "key": "burger", "label": "Free House Burger", "weight": 10 }
    ]
  },

  "campaign": { "startsAt": null, "endsAt": null },

  "legal": { "operator": "ClaimLabs", "note": "Demo manifest. Not a live campaign." }
